limit_max_ligands                                            yes
max_ligands                                                  10
skip_molecule                                                no
read_mol_solvation                                           no
calculate_rmsd                                               yes
use_rmsd_reference_mol                                       yes
rmsd_reference_filename                                      reference.mol2

